# Fact₹1 Environment Configuration

# App Config
APP_NAME=Fact₹1
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production
FRONTEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# Database
# For SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./fact1.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fact1_db

# Payment Gateway Configuration
# Mode can be 'cashfree', 'simulator', or 'razorpay'
PAYMENT_MODE=cashfree

# Cashfree Payments (PG v2023-08-01)
# Create credentials at https://merchant.cashfree.com/
CASHFREE_APP_ID=cf_test_placeholder_app_id
CASHFREE_SECRET_KEY=cf_secret_placeholder_secret_key
CASHFREE_ENV=sandbox # 'sandbox' or 'production'
CASHFREE_API_VERSION=2023-08-01

# Razorpay (Alternate Option)
PAYMENT_KEY_ID=rzp_test_placeholder_key_id
PAYMENT_KEY_SECRET=placeholder_secret_key
PAYMENT_WEBHOOK_SECRET=placeholder_webhook_secret

# Admin API Key (For accessing /admin and internal API management)
ADMIN_SECRET_KEY=admin_fact1_secure_key_2026

# Pricing (in INR Paise: 100 paise = ₹1.00)
DEFAULT_FACT_PRICE_PAISE=100
CURRENCY=INR
